#!/usr/bin/env bash

set -Eeuo pipefail

flag="/opt/instantos/.setup-done"
failure_flag="/opt/instantos/.setup-failed"

log() {
    printf '[instantos-setup] %s\n' "$1"
}

fail() {
    printf 'status=failed\nreason=%s\n' "$1" >"$failure_flag"
    log "ERROR: $1"
    exit 1
}

record_unexpected_failure() {
    local status="$1"
    local line="$2"
    printf 'status=failed\nexit_status=%s\nline=%s\n' \
        "$status" "$line" >"$failure_flag"
    log "ERROR: unexpected failure at line $line (exit $status)"
    exit "$status"
}

trap 'record_unexpected_failure "$?" "$LINENO"' ERR

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command is unavailable: $1"
}

if [[ -f "$flag" ]]; then
    log "setup already completed"
    exit 0
fi

touch /opt/livebuilder
mkdir -p /opt/instantos
rm -f "$failure_flag"

sources_manifest="/usr/share/instantos/build-sources.env"
build_inputs="/usr/share/instantos/build-inputs"
[[ -f "$sources_manifest" ]] || fail "build source manifest is missing"
# The manifest is generated by iso/build.sh from fixed URLs and validated Git hashes.
# shellcheck source=/dev/null
source "$sources_manifest"

for commit in "$DOTFILES_COMMIT" "$INSTANTTOOLS_COMMIT" "$LIVEUTILS_COMMIT"; do
    [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || fail "invalid commit in source manifest"
done

for command in git ins jq rg; do
    require_command "$command"
done

[[ -d "$build_inputs/dotfiles/.git" ]] || fail "bundled dotfiles repository is missing"
[[ -d "$build_inputs/instantTOOLS/.git" ]] || fail "bundled instantTOOLS repository is missing"
[[ "$(git -C "$build_inputs/dotfiles" rev-parse HEAD)" == "$DOTFILES_COMMIT" ]] ||
    fail "bundled dotfiles commit does not match the source manifest"
[[ "$(git -C "$build_inputs/instantTOOLS" rev-parse HEAD)" == "$INSTANTTOOLS_COMMIT" ]] ||
    fail "bundled instantTOOLS commit does not match the source manifest"

if ! id -u instantos >/dev/null 2>&1; then
    log "creating instantos user"
    empty_skel="/var/empty/instantos-skel"
    install -d -m 0755 "$empty_skel"
    useradd -m -k "$empty_skel" -s /bin/zsh instantos
    rmdir "$empty_skel"
    echo "instantos:instantos" | chpasswd
fi

ensure_group() {
    local group="$1"
    if ! getent group "$group" >/dev/null 2>&1; then
        log "creating group $group"
        groupadd "$group"
    fi
    if ! id -nG instantos | grep -qw "$group"; then
        log "adding instantos to $group"
        gpasswd -a instantos "$group" >/dev/null
    fi
}

for group in autologin video wheel input; do
    ensure_group "$group"
done

mkdir -p /etc/gdm
cat >/etc/gdm/custom.conf <<'EOF'
[daemon]
AutomaticLoginEnable=True
AutomaticLogin=instantos
EOF

# Select instantWM on the first autologin instead of relying on GDM's default.
mkdir -p /var/lib/AccountsService/users
cat >/var/lib/AccountsService/users/instantos <<'EOF'
[User]
Session=instantwm-wayland
SystemAccount=false
EOF

mkdir -p /etc/systemd/system
ln -sf /usr/lib/systemd/system/gdm.service /etc/systemd/system/display-manager.service
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /usr/lib/systemd/system/systemd-timesyncd.service \
    /etc/systemd/system/multi-user.target.wants/systemd-timesyncd.service

cleanup() {
    rm -f /opt/livebuilder
}
trap cleanup EXIT

if [[ ! -x /usr/share/instantos/rootinstall.sh ]]; then
    log "rootinstall script missing"
    exit 1
fi

log "running instantOS rootinstall"
bash /usr/share/instantos/rootinstall.sh

log "seeding and applying instantOS dotfiles for the live user"
dotfiles_dir="/home/instantos/.local/share/instant/dots/dotfiles"
if [[ ! -d "$dotfiles_dir/.git" ]]; then
    install -d -m 0755 -o instantos -g instantos "$(dirname "$dotfiles_dir")"
    git clone --no-hardlinks "$build_inputs/dotfiles" "$dotfiles_dir"
fi
chown -R instantos:instantos /home/instantos/.local
runuser -u instantos -- git -C "$dotfiles_dir" remote set-url origin "$DOTFILES_URL"
runuser -u instantos -- git -C "$dotfiles_dir" checkout -q "$DOTFILES_BRANCH"

if ! runuser -u instantos -- env HOME=/home/instantos \
    ins dot repo list | grep -qw dotfiles; then
    # Older partial builds may have copied Arch's skeleton .zshrc before the
    # dotfiles repository was configured. The live-image defaults are
    # authoritative during image creation.
    rm -f /home/instantos/.zshrc
    runuser -u instantos -- env HOME=/home/instantos \
        ins dot repo clone "$DOTFILES_URL" \
        --name dotfiles \
        --branch "$DOTFILES_BRANCH" \
        --read-only
fi
runuser -u instantos -- env HOME=/home/instantos ins dot apply

dot_status="$(runuser -u instantos -- env HOME=/home/instantos \
    ins --output json --no-color dot status)"
jq -e '
    .data.total_files > 0 and
    .data.clean_count == .data.total_files and
    .data.modified_count == 0 and
    .data.outdated_count == 0 and
    .data.encrypted_error_count == 0
' <<<"$dot_status" >/dev/null || fail "default dotfiles are not fully applied"

[[ "$(runuser -u instantos -- git -C "$dotfiles_dir" rev-parse HEAD)" == "$DOTFILES_COMMIT" ]] ||
    fail "installed dotfiles commit does not match the source manifest"
[[ "$(runuser -u instantos -- git -C "$dotfiles_dir" remote get-url origin)" == "$DOTFILES_URL" ]] ||
    fail "installed dotfiles origin is incorrect"

if [[ ! -f /etc/default/grub ]] || ! grep -q 'GRUB_THEME="/usr/share/grub/themes/instantos/theme.txt"' /etc/default/grub; then
    log "setting grub theme"
    echo 'GRUB_THEME="/usr/share/grub/themes/instantos/theme.txt"' >>/etc/default/grub
fi

if ! grep -q 'tzupdate &' /root/.zshrc 2>/dev/null; then
    log "queueing tzupdate"
    echo 'tzupdate &' >>/root/.zshrc
fi

log "installing developer tools from bundled source"
(
    cd "$build_inputs/instantTOOLS"
    bash ./install.sh
)

[[ -x /usr/local/bin/ibuild ]] || fail "ibuild was not installed"
[[ -f /usr/local/share/instanttools/version ]] || fail "instantTOOLS version is missing"
[[ "$(</usr/local/share/instanttools/version)" == "${INSTANTTOOLS_COMMIT:0:10}" ]] ||
    fail "installed instantTOOLS version does not match the source manifest"

rm -rf "$build_inputs"

cat >"$flag" <<EOF
status=complete
dotfiles_commit=$DOTFILES_COMMIT
instanttools_commit=$INSTANTTOOLS_COMMIT
liveutils_commit=$LIVEUTILS_COMMIT
EOF
rm -f "$failure_flag"
log "setup completed"
