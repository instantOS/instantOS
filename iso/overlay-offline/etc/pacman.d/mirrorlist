# instantOS offline bundle: local packages first, network mirrors heal gaps.
#
# Shipped only by the offline ISO build (merged after overlay/). The same
# template serves core, extra, multilib and instant — pacman expands
# $repo/$arch. The installer keeps this list as-is on the live system and
# the target (opportunistic), strips the file:// line at install finish
# (leaving the https fallback below), and strict mode replaces it with a
# file://-only list.
Server = file:///run/archiso/bootmnt/offline-repo/$repo/os/$arch
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
