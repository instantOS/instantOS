#!/usr/bin/env python3

"""Persistent live-session menu for reopening Welcome or the installer."""

import subprocess

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AppIndicator3", "0.1")
from gi.repository import AppIndicator3, Gtk


def launch(*command):
    subprocess.Popen(command, start_new_session=True)


def menu_item(label, command):
    item = Gtk.MenuItem(label=label)
    item.connect("activate", lambda _item: launch(*command))
    return item


def main():
    indicator = AppIndicator3.Indicator.new(
        "instantos-installer",
        "system-software-install",
        AppIndicator3.IndicatorCategory.APPLICATION_STATUS,
    )
    indicator.set_status(AppIndicator3.IndicatorStatus.ACTIVE)

    menu = Gtk.Menu()
    menu.append(menu_item("Install instantOS", ("/usr/bin/instantosinstaller",)))
    menu.append(menu_item("Open Welcome", ("ins", "welcome", "--gui", "--force-live")))
    menu.show_all()
    indicator.set_menu(menu)
    Gtk.main()


if __name__ == "__main__":
    main()
