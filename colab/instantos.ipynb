 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "header"
   },
   "source": [
    "# 🚀 instantOS Live ISO Build & Test VM\n",
    "\n",
    "Build instantOS from source, launch the live ISO inside a QEMU virtual machine, and interact with the desktop directly in your browser.\n",
    "\n",
    "[![instantOS Website](https://img.shields.io/badge/website-instantos.io-blue)](https://instantos.io) [![GitHub Repo](https://img.shields.io/badge/github-instantOS%2FinstantOS-black)](https://github.com/instantOS/instantOS)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "cellView": "form",
    "id": "step1_setup"
   },
   "outputs": [],
   "source": [
    "# @title 1. Initialize Environment & Clone Repository\n",
    "import os\n",
    "\n",
    "if not os.path.exists('instantOS'):\n",
    "    !git clone https://github.com/instantOS/instantOS.git\n",
    "\n",
    "%cd instantOS\n",
    "\n",
    "# Install 'just' command runner\n",
    "!which just >/dev/null 2>&1 || (curl --proto '=https' --tlsv1.2 -sSf https://just.systems/install.sh | sudo bash -s -- --to /usr/local/bin)\n",
    "\n",
    "# Print available justfile tasks\n",
    "!just --list"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "cellView": "form",
    "id": "step2_iso"
   },
   "outputs": [],
   "source": [
    "# @title 2. Prepare the instantOS ISO\n",
    "# @markdown Choose whether to download the latest prebuilt release ISO or build fresh from source:\n",
    "source_option = \"Download Latest Release ISO (Fast)\" # @param [\"Download Latest Release ISO (Fast)\", \"Build ISO from Source (5-10 mins)\"]\n",
    "\n",
    "if \"Download\" in source_option:\n",
    "    !just download-iso\n",
    "else:\n",
    "    !just build-iso\n",
    "    !cp -f iso/build/iso/*.iso instantos.iso"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "cellView": "form",
    "id": "step3_start_and_view"
   },
   "outputs": [],
   "source": [
    "# @title 3. Start VM & Open Desktop View\n",
    "# @markdown Starts the QEMU container and renders the instantOS desktop using Colab's native viewer:\n",
    "import time\n",
    "\n",
    "!just vm-up\n",
    "time.sleep(5)\n",
    "\n",
    "try:\n",
    "    from google.colab import output\n",
    "    # Provide both a full browser tab link and an embedded interactive view\n",
    "    output.serve_kernel_port_as_window(8006)\n",
    "    output.serve_kernel_port_as_iframe(8006, width=\"100%\", height=\"750\")\n",
    "except Exception as e:\n",
    "    print(\"Colab display note:\", e)\n",
    "    print(\"If running locally, navigate to http://localhost:8006\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "cellView": "form",
    "id": "step4_stop"
   },
   "outputs": [],
   "source": [
    "# @title 4. Stop & Clean Up VM\n",
    "!just vm-down"
   ]
  }
 ],
