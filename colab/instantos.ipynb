 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "header"
   },
   "source": [
    "# 🚀 instantOS Live ISO Build & Test VM\n",
    "\n",
    "Build instantOS from source, launch the live ISO inside a QEMU virtual machine, and interact with the desktop directly in your browser.\n",
    "\n",
    "[![instantOS Website](https://img.shields.io/badge/website-instantos.io-blue)](https://instantos.io) [![GitHub Repo](https://img.shields.io/badge/github-instantOS%2FinstantOS-black)](https://github.com/instantOS/instantOS)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "cellView": "form",
    "id": "step1_setup"
   },
   "outputs": [],
   "source": [
    "# @title 1. Initialize Environment & Clone Repository\n",
    "import os\n",
    "import subprocess\n",
    "import time\n",
    "\n",
    "# Clone repository if running in a fresh Colab environment\n",
    "if not os.path.exists('instantOS'):\n",
    "    !git clone https://github.com/instantOS/instantOS.git\n",
    "\n",
    "%cd instantOS\n",
    "\n",
    "# Install 'just' command runner if not present\n",
    "!which just >/dev/null 2>&1 || (curl --proto '=https' --tlsv1.2 -sSf https://just.systems/install.sh | sudo bash -s -- --to /usr/local/bin)\n",
    "\n",
    "# Check KVM hardware acceleration\n",
    "kvm_ok = os.path.exists('/dev/kvm') and os.access('/dev/kvm', os.R_OK | os.W_OK)\n",
    "print(f\"\\nVirtualization Mode: {'⚡ KVM Hardware Accelerated' if kvm_ok else '⚙️ Software Emulation (TCG)'}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "cellView": "form",
    "id": "step2_iso"
   },
   "outputs": [],
   "source": [
    "# @title 2. Prepare the instantOS ISO\n",
    "# @markdown Choose whether to build the ISO directly from source (takes ~5-10 mins) or download the latest prebuilt release ISO for instant testing:\n",
    "source_option = \"Download Latest Release ISO (Instant)\" # @param [\"Download Latest Release ISO (Instant)\", \"Build ISO from Source (5-10 mins)\"]\n",
    "\n",
    "if \"Download\" in source_option:\n",
    "    print(\"Fetching latest instantOS ISO release...\")\n",
    "    !curl -s https://api.github.com/repos/instantOS/instantOS/releases/latest \\\n",
    "      | grep \"browser_download_url.*\\.iso\\\"\" \\\n",
    "      | cut -d : -f 2,3 \\\n",
    "      | tr -d '\\\" ' \\\n",
    "      | head -n 1 \\\n",
    "      | xargs -I {} curl -L -o instantos.iso {}\n",
    "    if os.path.exists('instantos.iso') and os.path.getsize('instantos.iso') > 1000000:\n",
    "        print(\"✅ Download complete: instantos.iso\")\n",
    "    else:\n",
    "        print(\"⚠️ Could not fetch latest release. Building from source instead...\")\n",
    "        !just build-iso\n",
    "        !cp -f iso/build/iso/*.iso instantos.iso\n",
    "else:\n",
    "    print(\"Building instantOS live ISO inside Arch container...\")\n",
    "    !just build-iso\n",
    "    !cp -f iso/build/iso/*.iso instantos.iso\n",
    "    print(\"✅ Build complete: instantos.iso\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "cellView": "form",
    "id": "step3_start_vm"
   },
   "outputs": [],
   "source": [
    "# @title 3. Start the Test Virtual Machine\n",
    "print(\"Starting QEMU test VM...\")\n",
    "!just vm-up\n",
    "print(\"Waiting for VM display service to initialize...\")\n",
    "time.sleep(5)\n",
    "print(\"✅ VM is running!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "cellView": "form",
    "id": "step4_display"
   },
   "outputs": [],
   "source": [
    "# @title 4. Open instantOS Desktop View\n",
    "# @markdown Renders the desktop directly inside the notebook or in a separate popup window:\n",
    "\n",
    "try:\n",
    "    from google.colab import output\n",
    "    output.serve_kernel_port_as_window(8006)\n",
    "    output.serve_kernel_port_as_iframe(8006, width=\"100%\", height=\"750\")\n",
    "except Exception as e:\n",
    "    print(\"Embedded display note:\", e)\n",
    "    print(\"If running locally, navigate to http://localhost:8006\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "cellView": "form",
    "id": "step5_tunnel"
   },
   "outputs": [],
   "source": [
    "# @title 5. (Optional) External Fullscreen Browser Link\n",
    "# @markdown Generate a secure, temporary Cloudflare URL to open the VM in a full browser tab:\n",
    "import subprocess\n",
    "import time\n",
    "\n",
    "!which cloudflared >/dev/null 2>&1 || (wget -q -nc https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb && sudo dpkg -i cloudflared-linux-amd64.deb >/dev/null 2>&1)\n",
    "\n",
    "tunnel_proc = subprocess.Popen([\"cloudflared\", \"tunnel\", \"--url\", \"http://localhost:8006\"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\n",
    "time.sleep(3)\n",
    "for line in iter(tunnel_proc.stdout.readline, ''):\n",
    "    if \"trycloudflare.com\" in line:\n",
    "        for word in line.split():\n",
    "            if \"trycloudflare.com\" in word:\n",
    "                print(f\"\\n🔗 Open instantOS Fullscreen: {word}\\n\")\n",
    "        break"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "cellView": "form",
    "id": "step6_stop"
   },
   "outputs": [],
   "source": [
    "# @title 6. Stop & Clean Up VM\n",
    "!just vm-down\n",
    "print(\"VM stopped successfully.\")"
   ]
  }
 ],
